# Copy to .env and fill in. Leaving DB_* unset makes Django fall back to a local SQLite DB.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=
DB_HOST=

# Required for AI features (title/tags generation, summarize, improve writing, search, ask)
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-opus-4-8
ANTHROPIC_MODEL=
